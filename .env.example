# Copy to .env.local (local) or add in Vercel → Settings → Environment Variables.
# Everything is optional: without the Supabase pair the app runs in demo mode.

# Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: daily cron and inbound webhooks
SUPABASE_SERVICE_ROLE_KEY=

# Force demo mode even when Supabase is configured
DEMO_MODE=false

# Optional AI (server-only). Without it, reviewed templates and rules are used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Secrets: any long random strings
CRON_SECRET=
INBOUND_WEBHOOK_SECRET=
SESSION_SECRET=

# Optional providers; without them sends are recorded as "simulated"
RESEND_API_KEY=
# Inbound customer replies (Resend Receiving): webhook signing secret (whsec_...) and the receiving domain.
# Outbound emails get Reply-To reply+<organizationId>@INBOUND_EMAIL_DOMAIN.
RESEND_WEBHOOK_SECRET=
INBOUND_EMAIL_DOMAIN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: looping background video for the landing hero (a clip you own, e.g. /brand/hero.mp4).
NEXT_PUBLIC_HERO_VIDEO_URL=
